        {
          "id": "stock-entry",
          "name": "На складе — приёмка",
          "position": 4,
          "color": "lime",
          "type": "active",
          "sla_days": 3,
          "required_fields_on_enter": [],
          "required_fields_on_exit": [
            "stock_confirmed"
          ]
        },
        {
          "id": "metrology",
          "name": "Поверка / аттестация",
          "position": 5,
          "color": "blue",
          "type": "active",
          "sla_days": 10,
          "required_fields_on_enter": [],
          "required_fields_on_exit": [
            "metrology_certificate"
          ],
          "note": "Критичный этап для лабораторного оборудования — блокирует отгрузку"
        },
        {
          "id": "ready-to-ship",
          "name": "Готов к отгрузке",
          "position": 6,
          "color": "emerald",
          "type": "active",
          "sla_days": 5,
          "required_fields_on_enter": []
        },
        {
          "id": "delivering-install",
          "name": "Доставка / монтаж",
          "position": 7,
          "color": "cyan",
          "type": "active",
          "sla_days": 14,
          "required_fields_on_enter": [
            "delivery_date",
            "installation_engineer"
          ]
        },
        {
          "id": "docs-waiting",
          "name": "Закрывающие документы",
          "position": 8,
          "color": "violet",
          "type": "active",
          "sla_days": 14,
          "required_fields_on_enter": [],
          "required_fields_on_exit": [
            "closing_docs_received"
          ]
        },
        {
          "id": "complete",
          "name": "Выполнен",
          "position": 9,
          "color": "teal",
          "type": "terminal_won",
          "sla_days": null,
          "required_fields_on_enter": [
            "closing_docs_received"
          ]
        }
      ]
    },
    {
      "id": "aftersales",
      "name": "Постпродажное",
      "description": "Рекламации и возвраты — отдельный модуль, не воронка продаж",
      "owner_role": "support_manager",
      "stages": [
        {
          "id": "claim-new",
          "name": "Новая рекламация",
          "position": 1,
          "color": "red",
          "type": "initial",
          "required_fields_on_enter": [
            "linked_deal_id",
            "claim_description"
          ]
        },
        {
          "id": "claim-review",
          "name": "Рассмотрение",
          "position": 2,
          "color": "orange",
          "type": "active",
          "sla_days": 5
        },
        {
          "id": "claim-resolved",
          "name": "Решена",
          "position": 3,
          "color": "teal",
          "type": "terminal_won",
          "required_fields_on_enter": [
            "resolution_description"
          ]
        },
        {
          "id": "return",
          "name": "Возврат",
          "position": 4,
          "color": "rose",
          "type": "terminal_lost",
          "required_fields_on_enter": [
            "return_reason"
          ]
        }
      ]
