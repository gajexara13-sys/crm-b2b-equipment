{
  "boards": [
    {
      "id": "sales",
      "name": "Продажи",
      "description": "Воронка продаж — зона ответственности менеджера",
      "owner_role": "sales_manager",
      "stages": [
        {
          "id": "new",
          "name": "Новый лид",
          "position": 1,
          "color": "gray",
          "type": "initial",
          "sla_days": 1,
          "required_fields_on_enter": [],
          "required_fields_on_exit": [
            "contact_name",
            "company",
            "source"
          ]
        },
        {
          "id": "qualification",
          "name": "Квалификация",
          "position": 2,
          "color": "indigo",
          "type": "active",
          "sla_days": 2,
          "required_fields_on_enter": [],
          "required_fields_on_exit": [
            "budget",
            "decision_maker",
            "need_confirmed"
          ],
          "note": "BANT-проверка перед передачей инженерам"
        },
        {
          "id": "specification",
          "name": "Подбор / ТЗ",
          "position": 3,
          "color": "blue",
          "type": "active",
          "sla_days": 5,
          "required_fields_on_enter": [],
          "required_fields_on_exit": [
            "assigned_engineer",
            "equipment_model"
          ]
        },
        {
          "id": "quote-sent",
          "name": "КП отправлено",
          "position": 4,
          "color": "cyan",
          "type": "active",
          "sla_days": 5,
          "required_fields_on_enter": [
            "quote_amount",
            "quote_document"
          ],
          "required_fields_on_exit": [],
          "auto_reminder_days": 3
        },
        {
          "id": "negotiation",
          "name": "Переговоры",
          "position": 5,
          "color": "amber",
          "type": "active",
          "sla_days": 10,
          "required_fields_on_enter": [],
          "required_fields_on_exit": [],
          "escalate_to_rop_after_days": 10
        },
        {
          "id": "contract",
          "name": "Договор",
          "position": 6,
          "color": "emerald",
          "type": "active",
          "sla_days": 5,
          "required_fields_on_enter": [],
          "required_fields_on_exit": [
            "contract_number",
            "contract_date"
          ]
        },
        {
          "id": "invoice",
          "name": "Оплата",
          "position": 7,
          "color": "violet",
