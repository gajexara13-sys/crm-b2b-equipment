          "sla_days": 14,
          "required_fields_on_enter": [
            "invoice_amount"
          ],
          "required_fields_on_exit": [
            "payment_confirmed_date"
          ]
        },
        {
          "id": "transferred",
          "name": "Передан в производство",
          "position": 8,
          "color": "teal",
          "type": "handoff",
          "sla_days": null,
          "required_fields_on_enter": [],
          "required_fields_on_exit": [],
