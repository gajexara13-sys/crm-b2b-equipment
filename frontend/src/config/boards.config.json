          "note": "При переводе в этот статус автоматически создаётся карточка на доске 'Исполнение'"
        },
        {
          "id": "lost",
          "name": "Отказ / Проигрыш",
          "position": 9,
          "color": "red",
          "type": "terminal_lost",
          "sla_days": null,
          "required_fields_on_enter": [
            "lost_reason"
          ],
          "required_fields_on_exit": [],
          "lost_reason_options": [
            "Цена",
            "Сроки",
            "Проигрыш тендеру",
            "Ушёл к конкуренту",
            "Нет бюджета",
            "Нет потребности",
            "Не выходит на связь",
            "Другое"
          ]
        }
      ]
    },
    {
